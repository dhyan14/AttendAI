# Environment Variables Template
# Copy this to .env and fill in real values
# NEVER commit .env to git

# ─── Application ───────────────────────────────────────────
APP_NAME=AttendAI
APP_ENV=development
SECRET_KEY=your-super-secret-key-min-32-chars-change-this

# ─── Database (Supabase) ────────────────────────────────────
# Get from: Supabase → Settings → Database → Connection String → URI mode
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── Redis (Railway add-on) ────────────────────────────────
# Auto-provided by Railway when you add Redis service
REDIS_URL=redis://localhost:6379

# ─── Cloudflare R2 ─────────────────────────────────────────
# Get from: Cloudflare → R2 → Manage API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=attendai-media
R2_PUBLIC_URL=https://your-custom-domain.r2.dev

# ─── Firebase FCM ──────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ─── JWT ───────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Face Recognition ──────────────────────────────────────
FACE_RECOGNITION_THRESHOLD=0.35
FACE_MODEL_NAME=buffalo_l

# ─── CORS ──────────────────────────────────────────────────
# Add your Vercel frontend URL here
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
